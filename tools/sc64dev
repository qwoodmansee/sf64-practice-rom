#!/usr/bin/env bash
# Star Fox 64 Practice ROM — SummerCart64 dev loop.
#
# Usage:
#   sc64dev               REPL: pick a worktree, then [b]uild+upload / [u]pload / [q]uit
#   sc64dev .             REPL on current worktree (cwd)
#   sc64dev <branch>      REPL on the worktree whose branch matches <branch>
#   sc64dev <path>        REPL on the worktree at <path>
#   sc64dev build         one-shot: make practice
#   sc64dev upload        one-shot: upload only
#   sc64dev all           one-shot: build + upload
#   sc64dev help          show this message
#
# Env (optional):
#   SF64_REPO_ROOT     repo/worktree to use (skips discovery)
#   SF64_ROM           .z64 path (default: <wt>/build/starfox64.us.rev1.uncompressed.z64)
#   SC64_DEPLOYER      sc64deployer binary (default: from PATH)
#   SF64_MAKE_JOBS     make -j (default: 4)
#
# Upload flags: --direct --reboot (boot mode = ROM (direct), deployer requests reset).

set -euo pipefail

MAIN_REPO="${HOME}/code/sf64-practice-rom"
SC64_DEPLOYER="${SC64_DEPLOYER:-sc64deployer}"
SF64_MAKE_JOBS="${SF64_MAKE_JOBS:-4}"
DEFAULT_ROM_REL="build/starfox64.us.rev1.uncompressed.z64"

die() { echo "sc64dev: $*" >&2; exit 1; }

# Walk up from $1 looking for a Makefile that defines a `practice:` target.
find_practice_repo() {
  local d="$1"
  while [[ -n "$d" && "$d" != "/" ]]; do
    if [[ -f "$d/Makefile" ]] && grep -q '^practice:' "$d/Makefile" 2>/dev/null; then
      echo "$d"; return 0
    fi
    d="$(dirname "$d")"
  done
  return 1
}

resolve_repo_root() {
  if [[ -n "${SF64_REPO_ROOT:-}" ]]; then
    [[ -f "${SF64_REPO_ROOT}/Makefile" ]] || die "SF64_REPO_ROOT '$SF64_REPO_ROOT' has no Makefile"
    echo "${SF64_REPO_ROOT}"; return 0
  fi
  local r
  r="$(find_practice_repo "$PWD" 2>/dev/null || true)"
  if [[ -z "$r" ]]; then
    r="$(find_practice_repo "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" 2>/dev/null || true)"
  fi
  [[ -n "$r" ]] || die "no SF64 practice repo found from cwd or script dir"
  echo "$r"
}

worktree_label() {
  local p="$1"
  if [[ "$p" == "$MAIN_REPO" ]]; then
    echo "main"
  else
    basename "$p"
  fi
}

resolve_wt_arg() {
  local arg="$1"
  if [[ "$arg" == "." ]]; then
    git -C "$PWD" rev-parse --show-toplevel 2>/dev/null && return 0
    return 1
  fi
  if [[ -d "$arg" ]]; then
    (cd "$arg" && git rev-parse --show-toplevel 2>/dev/null) && return 0
    return 1
  fi
  git -C "$MAIN_REPO" worktree list --porcelain 2>/dev/null \
    | awk -v want="$arg" '
        /^worktree / { p = substr($0, 10) }
        /^branch /   { b = $2; sub("refs/heads/", "", b);
                       if (b == want) { print p; exit } }'
}

pick_worktree() {
  local -a paths branches
  local p="" b="" line
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) p="${line#worktree }" ;;
      "branch "*)   b="${line#branch refs/heads/}"; paths+=("$p"); branches+=("$b") ;;
      "")           ;;
    esac
  done < <(git -C "$MAIN_REPO" worktree list --porcelain 2>/dev/null)

  if (( ${#paths[@]} == 0 )); then
    die "no worktrees under $MAIN_REPO"
  fi
  if (( ${#paths[@]} == 1 )); then
    echo "${paths[0]}"; return 0
  fi

  echo "worktrees:" >&2
  local i
  for (( i=0; i<${#paths[@]}; i++ )); do
    printf "  %d) %s\n" "$((i+1))" "${branches[i]}" >&2
  done
  local pick
  read -r -p "> " pick
  [[ "$pick" =~ ^[0-9]+$ ]] && (( pick >= 1 && pick <= ${#paths[@]} )) \
    || die "bad choice"
  echo "${paths[$((pick-1))]}"
}

run_build() {
  local wt="$1"
  (cd "$wt" && make practice "-j${SF64_MAKE_JOBS}")
}

run_upload() {
  local rom="$1"
  command -v "$SC64_DEPLOYER" >/dev/null 2>&1 \
    || die "'$SC64_DEPLOYER' not on PATH"
  [[ -f "$rom" ]] || die "ROM not found: $rom"
  "$SC64_DEPLOYER" upload --direct --reboot "$rom"
}

# Single-keystroke read, portable across bash/zsh.
read_key() {
  local k
  if read -rsn1 k 2>/dev/null; then
    REPLY="$k"; return 0
  fi
  read -sk1 k
  REPLY="$k"
}

repl() {
  local wt="$1"
  local rom="${SF64_ROM:-$wt/$DEFAULT_ROM_REL}"
  local label
  label="$(worktree_label "$wt")"
  echo "sc64dev [$label]  [b]uild+upload  [u]pload  [q]uit"
  while true; do
    printf "> "
    read_key
    local key="$REPLY"
    case "$key" in
      b)
        echo "b"
        if run_build "$wt" && run_upload "$rom"; then
          echo "ok — reset console"
        fi
        ;;
      u)
        echo "u"
        if run_upload "$rom"; then
          echo "ok — reset console"
        fi
        ;;
      q|$'\003'|$'\004'|"")
        echo "q"
        break
        ;;
      *)
        echo "?  [b]uild+upload [u]pload [q]uit"
        ;;
    esac
  done
}

usage() {
  sed -n '2,/^set -euo/p' "$0" | sed -e 's/^# \{0,1\}//' -e '/^set -euo/d'
}

cmd="${1:-}"

case "$cmd" in
  build)
    REPO="$(resolve_repo_root)"
    run_build "$REPO"
    exit 0
    ;;
  upload)
    REPO="$(resolve_repo_root)"
    ROM="${SF64_ROM:-${REPO}/${DEFAULT_ROM_REL}}"
    run_upload "$ROM"
    exit 0
    ;;
  all)
    REPO="$(resolve_repo_root)"
    ROM="${SF64_ROM:-${REPO}/${DEFAULT_ROM_REL}}"
    run_build "$REPO"
    run_upload "$ROM"
    echo "ok — reset console"
    exit 0
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
esac

if [[ -n "$cmd" ]]; then
  WT="$(resolve_wt_arg "$cmd" || true)"
  [[ -n "$WT" ]] || die "no worktree matched '$cmd'"
else
  WT="$(pick_worktree)"
fi

repl "$WT"
