#!/usr/bin/env bash
# Star Fox 64 Practice ROM — SummerCart64 dev loop.
#
# Usage:
#   sc64dev               REPL: numbered worktree list, press N to build+upload
#   sc64dev build         one-shot: make practice (current worktree)
#   sc64dev all           one-shot: build + upload (current worktree)
#   sc64dev help          show this message
#
# Env (optional):
#   SF64_REPO_ROOT     repo/worktree to use (skips discovery, one-shot subcommands only)
#   SF64_ROM           .z64 path (default: <wt>/build/starfox64.us.rev1.uncompressed.z64)
#   SC64_DEPLOYER      sc64deployer binary (default: from PATH)
#   SF64_MAKE_JOBS     make -j (default: 4)
#
# Upload flags: --direct --reboot (boot mode = ROM (direct), deployer requests reset).

set -euo pipefail

MAIN_REPO="${HOME}/code/sf64-practice-rom"
SC64_DEPLOYER="${SC64_DEPLOYER:-sc64deployer}"
SF64_MAKE_JOBS="${SF64_MAKE_JOBS:-4}"
DEFAULT_ROM_REL="build/starfox64.us.rev1.uncompressed.z64"

die() { echo "sc64dev: $*" >&2; exit 1; }

# Walk up from $1 looking for a Makefile that defines a `practice:` target.
find_practice_repo() {
  local d="$1"
  while [[ -n "$d" && "$d" != "/" ]]; do
    if [[ -f "$d/Makefile" ]] && grep -q '^practice:' "$d/Makefile" 2>/dev/null; then
      echo "$d"; return 0
    fi
    d="$(dirname "$d")"
  done
  return 1
}

resolve_repo_root() {
  if [[ -n "${SF64_REPO_ROOT:-}" ]]; then
    [[ -f "${SF64_REPO_ROOT}/Makefile" ]] || die "SF64_REPO_ROOT '$SF64_REPO_ROOT' has no Makefile"
    echo "${SF64_REPO_ROOT}"; return 0
  fi
  local r
  r="$(find_practice_repo "$PWD" 2>/dev/null || true)"
  if [[ -z "$r" ]]; then
    r="$(find_practice_repo "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" 2>/dev/null || true)"
  fi
  [[ -n "$r" ]] || die "no SF64 practice repo found from cwd or script dir"
  echo "$r"
}

worktree_label() {
  local p="$1"
  if [[ "$p" == "$MAIN_REPO" ]]; then
    echo "main"
  else
    basename "$p"
  fi
}

run_build() {
  local wt="$1"
  (cd "$wt" && make practice "-j${SF64_MAKE_JOBS}")
}

run_upload() {
  local rom="$1"
  command -v "$SC64_DEPLOYER" >/dev/null 2>&1 \
    || die "'$SC64_DEPLOYER' not on PATH"
  [[ -f "$rom" ]] || die "ROM not found: $rom"
  "$SC64_DEPLOYER" upload --direct --reboot "$rom"
}

# Single-keystroke read, portable across bash/zsh.
read_key() {
  local k
  if read -rsn1 k 2>/dev/null; then
    REPLY="$k"; return 0
  fi
  read -sk1 k
  REPLY="$k"
}

repl() {
  local -a paths branches
  local p="" b="" line
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) p="${line#worktree }" ; b="" ;;
      "branch "*)   b="${line#branch refs/heads/}" ;;
      "")
        if [[ -n "$p" ]]; then
          paths+=("$p")
          branches+=("${b:-$(worktree_label "$p")}")
          p="" ; b=""
        fi
        ;;
    esac
  done < <(git -C "$MAIN_REPO" worktree list --porcelain 2>/dev/null)
  # flush last entry if porcelain output lacks trailing blank line
  if [[ -n "$p" ]]; then
    paths+=("$p")
    branches+=("${b:-$(worktree_label "$p")}")
  fi

  (( ${#paths[@]} > 0 )) || die "no worktrees under $MAIN_REPO"

  while true; do
    local i
    for (( i=0; i<${#paths[@]}; i++ )); do
      printf "  %d) %s\n" "$((i+1))" "${branches[i]}"
    done
    printf "  q) quit\n"
    printf "> "
    read_key
    local key="$REPLY"
    if [[ "$key" =~ ^[1-9]$ ]] && (( key >= 1 && key <= ${#paths[@]} )); then
      echo "$key"
      local wt="${paths[$((key-1))]}"
      local rom="${SF64_ROM:-$wt/$DEFAULT_ROM_REL}"
      if run_build "$wt" && run_upload "$rom"; then
        echo "ok — reset console"
      fi
    elif [[ "$key" == "q" || "$key" == $'\003' || "$key" == $'\004' || "$key" == "" ]]; then
      echo "q"
      break
    else
      echo "?  press 1-${#paths[@]}, q to quit"
    fi
  done
}

usage() {
  sed -n '2,/^set -euo/p' "$0" | sed -e 's/^# \{0,1\}//' -e '/^set -euo/d'
}

cmd="${1:-}"

case "$cmd" in
  build)
    REPO="$(resolve_repo_root)"
    run_build "$REPO"
    exit 0
    ;;
  all)
    REPO="$(resolve_repo_root)"
    ROM="${SF64_ROM:-${REPO}/${DEFAULT_ROM_REL}}"
    run_build "$REPO"
    run_upload "$ROM"
    echo "ok — reset console"
    exit 0
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  "")
    repl
    ;;
  *)
    die "unknown command '$cmd' (try: sc64dev help)"
    ;;
esac
